  <DataSources>
    <DataSource Name="NT_Crime_Analytics"><rd:SecurityType>None</rd:SecurityType><ConnectionProperties><DataProvider>PBIDATASET</DataProvider><ConnectString>Data Source=pbiazure://api.powerbi.com/;Identity Provider="https://login.microsoftonline.com/common, https://analysis.windows.net/powerbi/api, 9f248767-8e1a-42f3-836f-c092ab95ff70";Initial Catalog=sobe_wowvirtualserver-c46ef631-0408-4926-a2a5-64e5a64d7afb;Integrated Security=ClaimsToken</ConnectString></ConnectionProperties><rd:DataSourceID>9bcf0ed5-c4ef-4f0d-83c5-5f44e6116053</rd:DataSourceID><rd:PowerBIWorkspaceName>My workspace</rd:PowerBIWorkspaceName><rd:PowerBIDatasetName>NT_Crime_Analytics</rd:PowerBIDatasetName></DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="MonthlyAudit">
      <Query><DataSourceName>NT_Crime_Analytics</DataSourceName><CommandText>EVALUATE
SELECTCOLUMNS(
    SUMMARIZECOLUMNS(
        'Crime'[Month Start],
        'Crime'[Reporting Region],
        'Crime'[Offence Category],
        "TotalOffences", [Total Offences],
        "DVOffences", [Domestic Violence Offences],
        "AlcoholOffences", [Alcohol Related Offences],
        "MissingSA2Offences",
            CALCULATE(
                [Total Offences],
                FILTER(
                    'Crime',
                    ISBLANK('Crime'[Statistical Area 2])
                        || 'Crime'[Statistical Area 2] IN { "Not specified", "Unknown" }
                )
            ),
        "SourceRows", COUNTROWS('Crime')
    ),
    "ReportMonth", FORMAT('Crime'[Month Start], "yyyy-MM"),
    "ReportingRegion", 'Crime'[Reporting Region],
    "OffenceCategory", 'Crime'[Offence Category],
    "TotalOffences", [TotalOffences],
    "DVOffences", [DVOffences],
    "AlcoholOffences", [AlcoholOffences],
    "MissingSA2Offences", [MissingSA2Offences],
    "SourceRows", [SourceRows]
)
ORDER BY [ReportMonth], [ReportingRegion], [TotalOffences] DESC</CommandText></Query>
      <Fields>
        <Field Name="ReportMonth"><rd:TypeName>System.String</rd:TypeName><DataField>[ReportMonth]</DataField></Field>
        <Field Name="ReportingRegion"><rd:TypeName>System.String</rd:TypeName><DataField>[ReportingRegion]</DataField></Field>
        <Field Name="OffenceCategory"><rd:TypeName>System.String</rd:TypeName><DataField>[OffenceCategory]</DataField></Field>
        <Field Name="TotalOffences"><rd:TypeName>System.Int32</rd:TypeName><DataField>[TotalOffences]</DataField></Field>
        <Field Name="DVOffences"><rd:TypeName>System.Int32</rd:TypeName><DataField>[DVOffences]</DataField></Field>
        <Field Name="AlcoholOffences"><rd:TypeName>System.Int32</rd:TypeName><DataField>[AlcoholOffences]</DataField></Field>
        <Field Name="MissingSA2Offences"><rd:TypeName>System.Int32</rd:TypeName><DataField>[MissingSA2Offences]</DataField></Field>
        <Field Name="SourceRows"><rd:TypeName>System.Int32</rd:TypeName><DataField>[SourceRows]</DataField></Field>
      </Fields>
      <Filters>
        <Filter><FilterExpression>=Fields!ReportMonth.Value</FilterExpression><Operator>Equal</Operator><FilterValues><FilterValue>=Parameters!ReportMonth.Value</FilterValue></FilterValues></Filter>
        <Filter><FilterExpression>=IIF(Parameters!Region.Value = "All Territories", "All Territories", Fields!ReportingRegion.Value)</FilterExpression><Operator>Equal</Operator><FilterValues><FilterValue>=Parameters!Region.Value</FilterValue></FilterValues></Filter>
      </Filters>
    </DataSet>
  </DataSets>
