{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "regions",
  "position": {
    "x": 650,
    "y": 160,
    "width": 350,
    "height": 310,
    "z": 6,
    "tabOrder": 6
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Park"
                    }
                  },
                  "Property": "Region"
                }
              },
              "queryRef": "Park.Region",
              "nativeQueryRef": "Region"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Visits"
                    }
                  },
                  "Property": "Selected Year Visits"
                }
              },
              "queryRef": "Visits.Selected Year Visits",
              "nativeQueryRef": "Selected Year Visits"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "Visits"
                  }
                },
                "Property": "Selected Year Visits"
              }
            },
            "direction": "Descending"
          }
        ]
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Region comparison - selected year'"
                }
              }
            }
          }
        }
      ]
    },
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "defaultColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#444444'"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
