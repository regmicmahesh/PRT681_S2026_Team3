{
  "name": "NTParkVisits",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-AU",
    "sourceQueryCulture": "en-AU",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "Visits",
        "columns": [
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Year",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Region",
            "dataType": "string",
            "sourceColumn": "Region",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Park",
            "dataType": "string",
            "sourceColumn": "Park",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Visits",
            "dataType": "int64",
            "sourceColumn": "Visits",
            "summarizeBy": "none",
            "formatString": "#,0"
          }
        ],
        "measures": [
          {
            "name": "Total Visits",
            "expression": "SUM(Visits[Visits])",
            "formatString": "#,0"
          },
          {
            "name": "Selected Year",
            "expression": "MAX('Year'[Year])",
            "formatString": "0"
          },
          {
            "name": "Selected Year Visits",
            "expression": "VAR Y = [Selected Year]\nRETURN CALCULATE([Total Visits], REMOVEFILTERS('Year'), 'Year'[Year] = Y)",
            "formatString": "#,0"
          },
          {
            "name": "Previous Year Visits",
            "expression": "VAR Y = [Selected Year]\nRETURN CALCULATE([Total Visits], REMOVEFILTERS('Year'), 'Year'[Year] = Y - 1)",
            "formatString": "#,0"
          },
          {
            "name": "YoY Change",
            "expression": "DIVIDE([Selected Year Visits] - [Previous Year Visits], [Previous Year Visits])",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Visit Change",
            "expression": "IF(NOT ISBLANK([Previous Year Visits]), [Selected Year Visits] - [Previous Year Visits])",
            "formatString": "+#,0;-#,0;0"
          }
        ],
        "partitions": [
          {
            "name": "Visits",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"Year\", Int64.Type}, {\"Region\", type text}, {\"Park\", type text}, {\"Visits\", Int64.Type}})",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Year",
        "columns": [
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Year",
            "summarizeBy": "none",
            "isKey": true,
            "formatString": "0"
          }
        ],
        "partitions": [
          {
            "name": "Year",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "#table(type table [Year = Int64.Type], {{2021}, {2022}, {2023}, {2024}, {2025}})"
              ]
            }
          }
        ]
      },
      {
        "name": "Park",
        "columns": [
          {
            "name": "Park",
            "dataType": "string",
            "sourceColumn": "Park",
            "summarizeBy": "none",
            "isKey": true
          },
          {
            "name": "Region",
            "dataType": "string",
            "sourceColumn": "Region",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Park",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "Table.Distinct(Table.SelectColumns(Visits, {\"Park\", \"Region\"}))"
              ]
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "Visits_Year",
        "fromTable": "Visits",
        "fromColumn": "Year",
        "toTable": "Year",
        "toColumn": "Year",
        "fromCardinality": "many",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Visits_Park",
        "fromTable": "Visits",
        "fromColumn": "Park",
        "toTable": "Park",
        "toColumn": "Park",
        "fromCardinality": "many",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection"
      }
    ]
  }
}
